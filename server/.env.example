# Copia este archivo como .env (local) o pon estas variables en Railway → Variables
# Supabase → Project Settings → API (la service_role es secreta: solo en el servidor)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# URL del cliente en Vercel (varias separadas por comas) y, opcional, patrón de las vistas previas
CLIENT_URL=http://localhost:5173
# CLIENT_URL_PATTERN=^https://gundam-assemble-.*\.vercel\.app$
# Dónde se guardan partidas en curso y repeticiones: supabase en producción, file en local
GAME_STORE=file
# Opcionales
# TURN_SECONDS=120
# RESPONSE_SECONDS=30
# BOT_DELAY_MS=700

# Modo mesa (desactivado por ahora): 1 para permitir crear salas de mesa
MESA_ENABLED=
